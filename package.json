{
  "name": "hijri-day",
  "version": "1.0.0",
  "description": "A Hijri calendar (Based on Umm al-Qura calculations) plugin for day.js.",
  "main": "dist/hijri-day.cjs.min.js",
  "web": "dist/hijri-day.umd.min.js",
  "module": "dist/hijri-day.esm.js",
  "jsnext:main": "dist/hijri-day.esm.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "release": "standard-version",
    "build": "rollup -c",
    "check-size": "bundlesize",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "limit": "2.99 KB",
      "path": "dist/hijri-day.umd.min.js",
      "ignore": [
        "dayjs"
      ]
    },
    {
      "limit": "2.99 KB",
      "path": "dist/hijri-day.cjs.min.js",
      "ignore": [
        "dayjs"
      ]
    }
  ],
  "bundlesize": [
    {
      "path": "dist/hijri-day.cjs.js",
      "maxSize": "5 kB"
    },
    {
      "path": "dist/hijri-day.esm.js",
      "maxSize": "5 kB"
    },
    {
      "path": "dist/hijri-day.umd.js",
      "maxSize": "5 kB"
    }
  ],
  "keywords": [
    "hijri",
    "hijriah",
    "arabic",
    "lunar",
    "Umm al-Qura",
    "date",
    "calendar",
    "conversion",
    "convert",
    "day.js",
    "dayjs",
    "plugin",
    "moment"
  ],
  "author": "MohammadHossein MashhadiEbad",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@rollup/plugin-terser": "^0.4.4",
    "dayjs": "^1.11.13",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1",
    "rollup-plugin-filesize": "^10.0.0",
    "size-limit": "^11.1.6",
    "standard-version": "^9.5.0"
  }
}
